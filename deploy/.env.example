# Set IMAGE_TAG to the full reviewed Git SHA or export it in the shell.
IMAGE_TAG=
WEB_BIND=127.0.0.1:8080
WEB_ORIGINS=http://127.0.0.1:8080
ROOM_STORE=memory
DATABASE_URL=

# Optional AI. Use absolute paths for host bind mounts.
API_TARGET=base
AI_RUNTIME=litert
AI_SECRETS_DIR=../.local/ai-secrets
AI_ARTIFACT_DIR=../.local/ai-artifacts
AI_SERVICE_URL=
AI_BIND=127.0.0.1:8000
AI_PRIVATE_LINK=0
GUESSER_PROVIDER=unavailable
REFEREE_PROVIDER=unavailable
GUESSER_MODEL_ID=
REFEREE_MODEL_ID=
AI_SMOKE_TEST=0
AI_TEST_FIXTURES=0
