{
  "name": "mmtai-api",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/apps/api/src/main.js",
    "dev": "tsx watch src/main.ts",
    "test": "tsx --test --test-concurrency=1 test/*.test.ts src/game/*.test.ts",
    "prisma:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint src test",
    "pretest": "npm run build"
  },
  "dependencies": {
    "@nestjs/common": "12.3.3",
    "@nestjs/core": "12.3.3",
    "@nestjs/platform-express": "12.3.3",
    "@nestjs/platform-socket.io": "12.3.3",
    "@nestjs/websockets": "12.3.3",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "dotenv": "^17.2.0",
    "pg": "^8.16.0",
    "playwright": "1.64.1",
    "redis": "^6.3.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "socket.io": "4.8.4",
    "socket.io-client": "4.8.4"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/pg": "^8.15.0",
    "eslint": "^9.39.5",
    "prisma": "7.10.1",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.72.1"
  },
  "overrides": {
    "@typescript-eslint/typescript-estree": {
      "minimatch": "^11.0.1"
    }
  }
}
