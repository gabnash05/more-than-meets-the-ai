{
  "compilerOptions": {
    "target": "ES2022",
    "module": "commonjs",
    "moduleResolution": "node",
    "strict": true,
    "esModuleInterop": true,
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "skipLibCheck": true,
    "outDir": "dist",
    "rootDir": "../.."
  },
  "include": [
    "src/**/*.ts",
    "../../packages/game-contracts/src/**/*.ts"
  ],
  "exclude": [
    "src/generated",
    "src/**/*.test.ts"
  ]
}
